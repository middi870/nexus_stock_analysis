# NEXUS — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Backend ───────────────────────────────────────────────────────────────────
# Path to the SQLite database file.
# On Railway: set this to a path inside a mounted persistent volume (e.g. /data/nexus.db)
DB_PATH=/data/nexus.db

# Server port (Railway injects $PORT automatically)
PORT=8000

# CORS origins — space-separated list of allowed frontend origins.
# Set to your Railway frontend URL in production. Use * for open dev.
CORS_ORIGINS=*

# Local Ollama URL (host machine, not containerised)
OLLAMA_BASE_URL=http://localhost:11434

# Cloud AI provider keys (optional — can also be entered per-request in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ── Frontend ─────────────────────────────────────────────────────────────────
# Backend public URL used during the Vite build step.
# Must be set at BUILD TIME (not runtime) when using Docker.
# Leave as /api for local dev (Vite proxy handles it).
VITE_API_URL=/api
