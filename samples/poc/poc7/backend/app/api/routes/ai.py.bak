from fastapi import APIRouter, Depends, Query
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select, desc
from fastapi.responses import StreamingResponse

from app.db.session import get_db
from app.db.models import Stock
from app.services.ai_service import get_ai_insight
from app.services.conversation_service import save_conversation

router = APIRouter(prefix="/ai", tags=["ai"])


# ✅ NORMAL AI
@router.get("/insight/{symbol}")
async def ai_insight(
    symbol: str,
    provider: str = Query("auto"),
    db: AsyncSession = Depends(get_db)
):
    result = await db.execute(
        select(Stock)
        .where(Stock.symbol == symbol)
        .order_by(desc(Stock.date))
        .limit(1)
    )

    row = result.scalar()

    data = {
        "close": row.close,
        "rsi": row.rsi,
        "macd": row.macd,
        "macd_signal": row.macd_signal,
        "ma20": row.ma20,
        "ma50": row.ma50,
    }

    response = await get_ai_insight(symbol, data, provider)

    await save_conversation(db, symbol, provider, str(data), response)

    return {
        "symbol": symbol,
        "insight": response
    }


# 🌊 STREAMING
@router.get("/stream/{symbol}")
async def stream_ai(symbol: str):

    async def generator():
        text = "Streaming AI response coming soon..."
        for word in text.split():
            yield f"data: {word} \n\n"

    return StreamingResponse(generator(), media_type="text/event-stream")
